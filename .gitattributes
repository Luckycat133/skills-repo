# Normalize all text files to LF on every platform.
#
# Windows runners use core.autocrlf=true by default; CRLF working-tree
# copies break byte-level comparisons such as scripts/sync-root-mirror.sh
# --check and are fragile under Git Bash. Binary artifacts are exempt.

* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tgz binary
*.tar binary
*.whl binary
