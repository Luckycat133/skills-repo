{
  "project": "my-ml-project",
  "data_root": "datasets",
  "paths": {
    "train": {
      "raw": "datasets/train_data/raw",
      "processed": "datasets/train_data/processed",
      "metadata": "datasets/train_data/metadata"
    },
    "validation": {
      "raw": "datasets/validation_data/raw",
      "processed": "datasets/validation_data/processed",
      "metadata": "datasets/validation_data/metadata"
    },
    "test": {
      "raw": "datasets/test_data/raw",
      "processed": "datasets/test_data/processed",
      "metadata": "datasets/test_data/metadata"
    }
  },
  "split": {
    "input": "datasets/train_data/raw/full_dataset.csv",
    "label_col": "label",
    "test_ratio": 0.25,
    "val_ratio": 0.18,
    "seed": 42,
    "stratified": true
  },
  "version": {
    "current": "v1.0.0",
    "manifest_dir": "datasets/.manifests"
  }
}
