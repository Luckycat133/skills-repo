#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ -f scripts/sync-root-mirror.sh ]]; then
  if ! bash scripts/sync-root-mirror.sh --check; then
    echo "" >&2
    echo "ERROR: root SKILL.md is out of sync." >&2
    echo "Run: bash scripts/sync-root-mirror.sh && git add SKILL.md" >&2
    exit 1
  fi
fi
